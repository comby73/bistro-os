# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo académico: set a true para saltear auth y navegar sin login.
# Quitar (o setear false) antes de activar Supabase Auth en Fase 2.
DEMO_AUTH_BYPASS=true

# Supabase
# Este proyecto NO usa SUPABASE_KEY.
# Usar la URL pública, la anon key para cliente y la service role key solo en server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=never-expose-this-in-client

# n8n (integraciones opcionales; la app debe seguir funcionando si no están definidas)
N8N_LEAD_WEBHOOK_URL=https://your-n8n-instance/webhook/bistro-lead
N8N_RESERVATION_WEBHOOK_URL=https://your-n8n-instance/webhook/bistro-reservation
N8N_ORDER_WEBHOOK_URL=https://your-n8n-instance/webhook/bistro-order

# IA
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4.1-mini
